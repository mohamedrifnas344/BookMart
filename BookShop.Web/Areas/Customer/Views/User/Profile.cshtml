@model BookShop.Application.ViewModels.UserManagement.UserResponseVM

@{
    ViewData["Title"] = "My Profile";
}

<div class="container px-4 py-4">
    <!-- Header Section -->
    <div class="row align-items-center mb-4 pb-3 border-bottom g-3">
        <div class="col-12 col-md-6">
            <span class="text-uppercase text-muted font-monospace small fw-bold">Account Overview</span>
            <h1 class="h3 fw-bold text-dark mb-0">My Profile</h1>
        </div>
        <div class="col-12 col-md-6 text-md-end">
            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-outline-primary rounded-pill px-3">

                <i class="bi bi-arrow-left me-2"></i>
                Back to Home
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Profile Summary Card -->
        <div class="col-xl-4">
            <div class="card border-0 shadow-sm rounded-4 bg-white text-center p-4 h-100">
                <div class="card-body d-flex flex-column align-items-center justify-content-center py-4">
                    <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold text-uppercase mb-3 shadow-sm" style="width: 90px; height: 90px; font-size: 2.2rem;">
                        @(Model?.FirstName?.Length > 0 ? Model.FirstName.Substring(0, 1) : "")@(Model?.LastName?.Length > 0 ? Model.LastName.Substring(0, 1) : "")
                    </div>
                    <h4 class="fw-bold text-dark mb-1">@Model.FirstName @Model.LastName</h4>
                    <p class="text-muted font-monospace small mb-3">@Model.Email</p>
                    <div>
                        <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2 fw-semibold font-monospace">
                            <i class="bi bi-shield-check me-1"></i> @Model.Role
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Detailed Info Card -->
        <div class="col-xl-8">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4 h-100">
                <div class="card-body p-2">
                    <h5 class="fw-bold text-dark mb-4 d-flex align-items-center gap-2 border-bottom pb-3">
                        <i class="bi bi-person-lines-fill text-primary fs-5"></i> Profile Information
                    </h5>

                    <div class="row g-3">
                        <div class="col-12">
                            <div class="p-3 bg-light rounded-3 border-0">
                                <span class="text-muted small font-monospace d-block mb-1">User ID</span>
                                <span class="fw-semibold text-dark font-monospace text-break">@Model.UserId</span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border-0">
                                <span class="text-muted small font-monospace d-block mb-1">First Name</span>
                                <span class="fw-semibold text-dark">@Model.FirstName</span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border-0">
                                <span class="text-muted small font-monospace d-block mb-1">Last Name</span>
                                <span class="fw-semibold text-dark">@Model.LastName</span>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="p-3 bg-light rounded-3 border-0">
                                <span class="text-muted small font-monospace d-block mb-1">Email Address</span>
                                <span class="fw-semibold text-dark font-monospace">@Model.Email</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>