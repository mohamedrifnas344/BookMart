@model BookShop.Application.ViewModels.Account.LoginRequestVM

@{
    ViewData["Title"] = "Login";
}

<div class="container my-5" style="max-width: 500px;">
    <div class="card border-0 shadow-sm rounded-4 p-4 p-sm-5 bg-white">
        <div class="text-center mb-4">
            <h2 class="fw-bold text-dark mb-1">Sign In</h2>
            <p class="text-muted small">Enter your credentials to access your account</p>
        </div>

        <form asp-area="Identity" asp-controller="Account" asp-action="Login"
        method="post">
            <div class="row g-3">

                <input type="hidden" asp-for="ReturnUrl"/>

                @* Email Address *@
                <div class="col-12">
                    <label asp-for="Email" class="form-label small fw-semibold text-secondary"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="bi bi-envelope"></i>
                        </span>
                        <input asp-for="Email" class="form-control bg-light border-start-0 ps-1" placeholder="yourname@domain.com" />
                    </div>
                    <span asp-validation-for="Email" class="d-block mt-1 text-danger small"></span>
                </div>

                @* Password *@
                <div class="col-12">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label asp-for="Password" class="form-label small fw-semibold text-secondary mb-0"></label>
                    </div>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="bi bi-lock"></i>
                        </span>
                        <input asp-for="Password" class="form-control bg-light border-start-0 ps-1" placeholder="Enter your password" type="password" />
                    </div>
                    <span asp-validation-for="Password" class="d-block mt-1 text-danger small"></span>
                </div>

                <div class="col-12 d-grid mt-3">
                    <button type="submit" class="btn btn-dark btn-lg fw-bold py-2 fs-6">
                        Sign In
                    </button>
                </div>
            </div>
        </form>

        <div class="text-center mt-4">
            <p class="text-muted small mb-0">
                Don't have an account?
                <a asp-area="Identity" asp-controller="Account" asp-action="Register"
                   class="text-dark fw-bold text-decoration-none">Create an Account</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}