@{
    ViewData["Title"] = "Access Denied";
}


<div class="container d-flex align-items-center justify-content-center my-5 px-3">
    <div class="card shadow border-0 rounded-4 p-4 p-sm-4 text-center bg-white"
         style="max-width: 480px;">
        <div class="d-inline-flex align-items-center justify-content-center bg-danger-subtle rounded-circle mb-4 mx-auto"
             style="width: 90px; height: 90px;">
            <i class="bi bi-shield-lock-fill text-danger fs-1"></i>
        </div>
        <h2 class="fw-bold text-dark mb-2">Access Denied</h2>
        <p class="text-muted small mb-4 px-1">
            You do not have the required permissions to view this resourses.
            Please ensure you are logged into the correct account or navigate back to your dashboard.
        </p>
        <div class="d-grid gap-2">
            <a asp-area="Customer" asp-controller="Home" asp-action="Index"
               class="btn btn-primary fw-semibold rounded-pill py-2 px-4">
                <i class="bi bi-house-door-fill me-2"></i> Return to Home Portal
            </a>
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
               class="btn btn-primary fw-semibold rounded-pill py-2 px-4">
                <i class="bi bi-speedometer2 me-2"></i> Return to Admin Dashboard
            </a>
        </div>
    </div>
</div>
