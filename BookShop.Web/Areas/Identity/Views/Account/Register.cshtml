@model BookShop.Application.ViewModels.Account.RegisterRequestVM

@{
    ViewData["Title"] = "Register";
}

<div class="container my-5" style="max-width: 600px;">
    <div class="card border-0 shadow-sm rounded-4 p-4 p-sm-5 bg-white">
        <div class="text-center mb-4">
            <h2 class="fw-bold text-dark mb-1">Create an Account</h2>
            <p class="text-muted small">Enter your details to get started</p>
        </div>

        <form asp-area="Identity" asp-controller="Account" asp-action="Register"
        method="post">
            <div class="row g-3">

                @* First Name *@
                <div class="col-sm-6">
                    <label asp-for="FirstName" class="form-label small fw-semibold text-secondary"></label>
                    <input asp-for="FirstName" class="form-control" placeholder="John" />
                    <span asp-validation-for="FirstName" class="d-block mt-1 text-danger small"></span>
                </div>

                @* Last Name *@
                <div class="col-sm-6">
                    <label asp-for="LastName" class="form-label small fw-semibold text-secondary"></label>
                    <input asp-for="LastName" class="form-control" placeholder="Doe" />
                    <span asp-validation-for="LastName" class="d-block mt-1 text-danger small"></span>
                </div>

                @* Email Address *@
                <div class="col-12">
                    <label asp-for="Email" class="form-label small fw-semibold text-secondary"></label>
                    <input asp-for="Email" class="form-control" placeholder="yourname@domain.com" />
                    <span asp-validation-for="Email" class="d-block mt-1 text-danger small"></span>
                </div>

                @* Password *@
                <div class="col-12">
                    <label asp-for="Password" class="form-label small fw-semibold text-secondary"></label>
                    <input asp-for="Password" class="form-control" placeholder="Choose a strong password" type="password" />
                    <span asp-validation-for="Password" class="d-block mt-1 text-danger small"></span>
                </div>

                @* Confirm Password *@
                <div class="col-12">
                    <label asp-for="ConfirmPassword" class="form-label small fw-semibold text-secondary"></label>
                    <input asp-for="ConfirmPassword" class="form-control" placeholder="Repeat your password" type="password" />
                    <span asp-validation-for="ConfirmPassword" class="d-block mt-1 text-danger small"></span>
                </div>

                <div class="col-12 d-grid mt-4">
                    <button type="submit" class="btn btn-dark btn-lg fw-bold py-2 fs-6">
                        Register
                    </button>
                </div>
            </div>
        </form>

        <div class="text-center mt-4">
            <p class="text-muted small mb-0">
                Already have an account?
                <a asp-area="Identity" asp-controller="Account" asp-action="Login"
                    class="text-dark fw-bold text-decoration-none">Sign In</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}