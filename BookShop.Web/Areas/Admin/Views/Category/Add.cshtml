@model BookShop.Application.ViewModels.Category.CategoryAddVM

@{
    ViewData["Title"] = "Add Category";
}


<div class="row justify-content-center py-5">
    <div class="col-xl-5 col-lg-6 col-md-8">

        <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white">
            <div class="card-header bg-transparent border-bottom px-4 py-3 text-center text-md-start">
                <h1 class="h3 fw-bold text-dark mb-1">Create Category</h1>
                <p class="text-muted small mb-0">
                    Add a new category to organize your catalog items.
                </p>
            </div>
            <!-- Body -->
            <div class="card-body">
                <form asp-area="Admin" asp-controller="Category" asp-action="Add"
                method="post">

                    <!-- Category Name -->
                    <div class="mb-4">
                        <label asp-for="Name" class="form-label fw-semibold text-secondary small text-uppercase">
                            Category Name
                        </label>
                        <div class="input-group input-group-lg shadow-sm rounded-3 overflow-hidden">
                            <span class="input-group-text bg-light border-end-0 text-muted px-3">
                                <i class="bi bi-folder2-open"></i>
                            </span>
                            <input asp-for="Name" class="form-control border-start-0 bg-light py-2 fs-6"
                                   placeholder="e.g., History, Horror , Drama" />
                        </div>
                        <span asp-validation-for="Name" class="mt-1 text-danger d-block"></span>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex align-items-center justify-content-end gap-3 pt-3 border-top">
                        <a asp-area="Admin" asp-controller="Category" asp-action="Index"
                           class="btn btn-outline-secondary px-3 py-1 rounded-pill fw-medium d-inline-flex
                            align-items-center
                            transition-all">
                            <i class="bi bi-arrow-left me-2"></i>
                            Cancel
                        </a>
                        <button type="submit"
                                class="btn btn-primary px-3 py-1 rounded-pill fw-semibold shadow-sm d-inline-flex
                            align-items-center">
                            <i class="bi bi-check2-circle me-2"></i>
                            Save Category
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}