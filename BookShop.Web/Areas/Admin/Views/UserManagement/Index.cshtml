@model List<BookShop.Application.ViewModels.UserManagement.UserResponseVM>

<div class="container-fluid px-4 py-4">
    <!-- Header Section -->
    <div class="row align-items-center mb-4 pb-3 border-bottom g-3">
        <div class="col-12 col-md-6">
            <span class="text-uppercase text-muted font-monospace small fw-bold">System Administration</span>
            <h1 class="h3 fw-bold text-dark mb-0">User Management</h1>
        </div>
        <div class="col-12 col-md-6 text-md-end">
            <div class="d-inline-flex align-items-center bg-white border shadow-sm px-3 py-2 rounded-pill">
                <span class="text-muted small me-2 font-monospace">Total Accounts:</span>
                <span class="badge bg-primary rounded-pill">@Model.Count</span>
            </div>
        </div>
    </div>

    <!-- Main Content Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase font-monospace fs-7 text-muted border-bottom">
                        <tr>
                            <th scope="col" class="ps-4 py-3">User Details</th>
                            <th scope="col" class="py-3">Email Address</th>
                            <th scope="col" class="py-3" style="width: 200px;">Access Role</th>
                            <th scope="col" class="py-3 text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var user in Model)
                            {
                                <tr>
                                    <td class="ps-4 py-3">
                                        <div class="d-flex align-items-center">
                                            <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold text-uppercase me-3 flex-shrink-0" style="width: 42px; height: 42px;">
                                                @(user.FirstName.Length > 0 ? user.FirstName.Substring(0, 1) : "")@(user.LastName.Length > 0 ? user.LastName.Substring(0, 1) : "")
                                            </div>
                                            <div>
                                                <div class="fw-semibold text-dark">@user.FirstName @user.LastName</div>
                                                <small class="text-muted d-block d-md-none font-monospace">@user.Email</small>
                                            </div>
                                        </div>
                                    </td>

                                    <td class="py-3 text-secondary font-monospace small">
                                        @user.Email
                                    </td>

                                    <td class="py-3">
                                        <form asp-area="Admin" asp-controller="UserManagement" asp-action="UpdateRole"
                                        method="post">
                                            <input type="hidden" name="userId" value="@user.UserId"/>
                                            <select name="Role"
                                            class="form-select form-select-sm fw-semibold role-select rounded-pill px-3 py-2
                                                border-secondary-subtle">

                                                <option value="ADMIN" selected="@(user.Role == "ADMIN")">
                                                    ADMIN
                                                </option>

                                                <option value="USER" selected="@(user.Role == "USER")">
                                                    USER
                                                </option>

                                            </select>
                                        </form>
                                    </td>

                                    <td class="py-3 text-end pe-4">
                                        <form asp-area="Admin" asp-controller="UserManagement" asp-action="DeleteUser"
                                              method="post" class="delete-form d-inline">
                                        <input type="hidden" name="userId" value="@user.UserId"/>
                                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-circle p-2
                                                d-inline-flex align-items-center justify-content-center"
                                                    style="width: 34px; height: 34px;" title="Delete User">
                                                <i class="bi bi-trash fs-6"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5">
                                    <div class="py-4 text-muted">
                                        <div class="bg-light rounded-circle d-inline-flex p-4 mb-3 text-secondary">
                                            <i class="bi bi-people fs-1"></i>
                                        </div>
                                        <h5 class="fw-semibold text-dark">No users found</h5>
                                        <p class="small text-muted mb-0">There are currently no registered accounts in the database.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


@section Scripts{
    <script>
        $(document).ready(function(){
            $('.role-select').change(function(){
                $(this).closest("form").submit();
            });

            $('.delete-form').on('submit', function(e) {
                e.preventDefault();
                var form = this;

                Swal.fire({
                    title: 'Are you sure?',
                    text: 'You are about to delete this User.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#dc3545',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Yes, delete it',
                    cancelButtonText: 'Cancel',
                    reverseButtons: true
                }).then(function(result) {

                    if (result.isConfirmed) {
                        form.submit();
                    }

                });
            });
        });
    </script>
}