@model List<BookShop.Application.ViewModels.Book.BookResponseVM>

@{
    ViewData["Title"] = "Book List";
}


<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-2">
                    <i class="bi bi-book-half fs-4"></i>
                </div>

                <div>
                    <h3 class="fw-bold text-dark mb-0">
                        Book Management
                    </h3>

                    <small class="text-muted">
                        Manage your bookstore catalog and inventory
                    </small>
                </div>
            </div>
        </div>

        <a asp-area="Admin" asp-controller="Book" asp-action="Add"
            class="btn btn-primary rounded-3 px-4 py-2 shadow-sm">
            <i class="bi bi-plus-lg me-2"></i>
            Add New Book
        </a>
    </div>

    <!-- Main Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

        <!-- Card Header -->
        <div class="card-header bg-white border-bottom px-4 py-3">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div>
                    <h5 class="fw-bold text-dark mb-1">
                        Book Catalog
                    </h5>
                    <small class="text-muted">
                        View and manage all books
                    </small>
                </div>
            </div>
        </div>
        <!-- Card Body -->
        <div class="card-body p-0">
            
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4 py-3 text-secondary small text-uppercase">
                                    Book
                                </th>
                                <th class="py-3 text-secondary small text-uppercase">
                                    Image
                                </th>
                                <th class="py-3 text-secondary small text-uppercase">
                                    Price
                                </th>
                                <th class="py-3 text-secondary small text-uppercase">
                                    Special Price
                                </th>
                                <th class="py-3 text-secondary small text-uppercase">
                                    Author
                                </th>
                                <th class="py-3 text-secondary small text-uppercase">
                                    Category
                                </th>
                                <th class="py-3 text-center text-secondary small text-uppercase">
                                    Actions
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach(var book in Model)
                            {
                                <tr class="book-row">

                                    <!-- Book -->
                                    <td class="ps-4">
                                        <div class="fw-semibold text-dark">
                                            @book.Title
                                        </div>
                                    </td>
                                    <!-- Image -->
                                    <td>
                                        <img src="@book.ImageUrl"
                                             alt="@book.Title"
                                             class="img-thumbnail rounded-3"
                                             width="55"
                                             height="70" />
                                    </td>
                                    <!-- Price -->
                                    <td>
                                        <span class="fw-semibold text-dark">
                                            $@book.Price.ToString("F2")
                                        </span>
                                    </td>
                                    <!-- Special Price -->
                                    <td>
                                        @if(book.SpecialPrice.HasValue && book.SpecialPrice.Value < book.Price)
                                        {
                                            <span class="text-success border-success-subtle">
                                                $@book.SpecialPrice.Value.ToString("F2")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }
                                    </td>
                                    <!-- Author -->
                                    <td>
                                        <span class="text-dark">
                                            @book.AuthorName
                                        </span>
                                    </td>
                                    <!-- Category -->
                                    <td>
                                        <span class="badge bg-light text-dark border rounded-pill px-3 py-2">
                                            @book.CategoryName
                                        </span>
                                    </td>
                                    <!-- Actions -->
                                    <td>
                                        <div class="d-flex justify-content-center gap-2">
                                            <!-- Details -->
                                            <a asp-area="Admin" asp-controller="Book" asp-action="Details"
                                            asp-route-id="@book.Id"
                                                class="btn btn-outline-info btn-sm rounded-3"
                                               title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>

                                            <!-- Edit -->
                                            <a asp-area="Admin" asp-controller="Book" asp-action="Edit"
                                            asp-route-id="@book.Id"
                                                class="btn btn-outline-warning btn-sm rounded-3"
                                               title="Edit Book">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>

                                            <!-- Delete -->
                                            <form asp-area="Admin" asp-controller="Book" asp-action="Delete"
                                                  asp-route-id="@book.Id" method="post"
                                                class="delete-form d-inline">
                                                <button type="submit"
                                                        class="btn btn-outline-danger btn-sm rounded-3"
                                                        title="Delete Book">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <!-- Empty State -->
                <div class="text-center py-5 px-3">
                    <div class="bg-light text-secondary rounded-circle d-inline-flex align-items-center justify-content-center p-4 mb-3">
                        <i class="bi bi-journal-x fs-1"></i>
                    </div>
                    <h5 class="fw-bold text-dark">
                        No Books Found
                    </h5>
                    <p class="text-muted mx-auto mb-4"
                       style="max-width: 400px;">
                        Your bookstore catalog is currently empty.
                        Add your first book to start building your inventory.
                    </p>
                    <a asp-area="Admin" asp-controller="Book" asp-action="Add"
                        class="btn btn-primary rounded-3 px-4 py-2">
                        <i class="bi bi-plus-lg me-2"></i>
                        Add Your First Book
                    </a>
                </div>
            }
        </div>
    </div>
</div>


@section Scripts {
    <script>
        $(document).ready(function() {

            $('.delete-form').on('submit', function(e) {
                e.preventDefault();
                var form = this;

                Swal.fire({
                    title: 'Are you sure?',
                    text: 'You are about to delete this category.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#dc3545',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Yes, delete it',
                    cancelButtonText: 'Cancel',
                    reverseButtons: true
                }).then(function(result) {

                    if (result.isConfirmed) {
                        form.submit();
                    }

                });
            });
        });
    </script>
}
