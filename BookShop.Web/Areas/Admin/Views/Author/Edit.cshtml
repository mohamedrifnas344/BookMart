@model BookShop.Application.ViewModels.Author.AuthorEditVM
@{
    ViewData["Title"] = "Edit Author";
}


<div class="row justify-content-center pt-3">
    <div class="col-lg-6 col-md-8">
        <div class="card shadow-sm border-0 rounded-4">

            <!-- Header -->
            <div class="card-header bg-white border-0 py-3 px-4">
                <h4 class="mb-0 fw-bold">
                    Edit Author
                </h4>
            </div>

            <!-- Body -->
            <div class="card-body p-4">
                <form asp-area="Admin" asp-controller="Author" asp-action="Edit"
                method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Id"/>
                    <!-- Author Name -->
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">
                            Author Name
                        </label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-person"></i>
                            </span>
                            <input asp-for="Name" class="form-control"
                                   placeholder="Enter author name"
                                   autofocus />
                        </div>
                        <span asp-validation-for="Name" class="text-danger small">
                        </span>
                    </div>

                    <!-- Biography -->
                    <div class="mb-3">
                        <label asp-for="Biography" class="form-label fw-semibold">
                            Biography
                        </label>

                        <textarea asp-for="Biography" class="form-control"
                                  rows="5"
                                  placeholder="Write a short biography about the author..."
                                  style="resize: none;"></textarea>

                        <span asp-validation-for="Biography" class="text-danger small">
                        </span>
                    </div>

                    <!-- Author Image -->
                    <div class="mb-4">

                        <label asp-for="File" class="form-label fw-semibold d-block">
                            Author Image
                        </label>

                        <!-- Hidden File Input -->
                        <input asp-for="File" type="file"
                               id="imageUpload"
                               class="d-none"
                               accept="image/png,image/jpeg,image/webp" />

                        <!-- Upload Box -->
                        <div class="w-50 border rounded-4 p-3 text-center bg-light"
                             id="uploadBox"
                             style="cursor: pointer;">

                            <!-- Preview (New Upload) -->
                            <img id="previewImage"
                                 src=""
                                 alt="Author preview"
                                 class="img-fluid rounded-circle shadow-sm d-none mx-auto"
                                 style="width: 150px; height: 150px; object-fit: cover;" />

                            <!-- Existing Image (Loaded from DB) -->
                            @if (!string.IsNullOrEmpty(Model.ExistingImageUrl))
                            {
                                <img id="existingImage"
                                     src="@Model.ExistingImageUrl"
                                     alt="Current author image"
                                     class="img-fluid rounded-circle shadow-sm mx-auto"
                                     style="width: 150px; height: 150px; object-fit: cover;" />
                            }

                            <!-- Placeholder (Only shown if no existing image) -->
                            <div id="uploadPlaceholder"
                                 class="py-4 @(!string.IsNullOrEmpty(Model.ExistingImageUrl) ? "d-none" : "")">
                                <i class="bi bi-person-circle fs-1 text-secondary"></i>
                                <div class="mt-2 text-muted small">
                                    Click to upload author image
                                </div>

                                <div class="text-muted small mt-1">
                                    PNG, JPG, WEBP · Max 5MB
                                </div>
                            </div>

                            <!-- Change Text -->
                            <div class="mt-3 text-muted small @(string.IsNullOrEmpty(Model.ExistingImageUrl) ? "d-none" : "")"
                                 id="uploadText">
                                Click to change image
                            </div>
                        </div>

                        <span asp-validation-for="File" class="text-danger small d-block"
                              id="fileErrorSpan">
                        </span>
                    </div>

                    <!-- Buttons -->
                    <div class="d-flex justify-content-between mt-4">
                        <a asp-area="Admin" asp-controller="Author" asp-action="Index"
                            class="btn btn-light border">
                            <i class="bi bi-arrow-left me-1"></i>
                            Back
                        </a>

                        <button type="submit"
                                class="btn btn-primary px-4">
                            <i class="bi bi-check-lg me-1"></i>
                            Update Author
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        $(document).ready(function() {

            // Open file picker
            $("#uploadBox").click(function() {
                $("#imageUpload").click();
            });

            // Preview image
            $("#imageUpload").change(function(event) {

                const file = event.target.files[0];
                if (!file) {
                    return;
                }

                const reader = new FileReader();

                reader.onload = function(e) {
                    // Hide existing image if it was rendered
                    $("#existingImage").addClass("d-none");

                    $("#previewImage")
                        .attr("src", e.target.result)
                        .removeClass("d-none");

                    $("#uploadPlaceholder")
                        .addClass("d-none");

                    $("#uploadText")
                        .removeClass("d-none")
                        .text("Click to change image");
                };

                reader.readAsDataURL(file);

            });

            // Form submit
            $("form").on("submit", function() {

                const form = $(this);

                // Client-side validation
                if (!form.valid()) {
                    return false;
                }
            });
        });

    </script>
}

