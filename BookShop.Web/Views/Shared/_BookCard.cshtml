@model List<BookShop.Application.ViewModels.Book.BookResponseVM>

@if (!Model.Any())
{
    <div class="text-center py-5 my-4 mx-auto">
        <div class="bg-light d-inline-flex p-4 rounded-circle mb-3 border-light-subtle">
            <i class="bi bi-book text-muted display-4"></i>
        </div>
        <h4 class="fw-bold text-dark">No books found</h4>
        <p class="text-muted small">Try tweaking search, filters, or check back later!</p>
    </div>
}

@foreach (var item in Model)
{

    <div class="col book-card rounded">
        <div class="card h-100 border-0 shadow-sm rounded-4 bg-white position-relative
            text-decoration-none text-reset border-top border-light opacity-100 transition-all translate-middle-y-hover">

            <!-- Container for the book cover image -->
            <div class="position-relative bg-light w-100 rounded" style="height: 290px;">
                <a asp-area="Customer" asp-controller="Book" asp-action="Details"
                asp-route-id="@item.Id"
                    class="text-center">
                    <img src="@item.ImageUrl" alt="@item.Title"
                         class="" style="width: 100%; height: 100%;" loading="lazy" />
                </a>
            </div>

            <div class="card-body p-3 p-xl-4 d-flex flex-column justify-content-between">

                <div class="mb-2">
                    <div class="mb-1 text-uppercase d-flex justify-content-between align-items-center">
                        <span class="text-danger fw-bold me-2" style="font-size: 0.75rem; max-width: 60%;">
                            @item.CategoryName
                        </span>
                    </div>
                    <h6 class="fw-bold text-dark my-1 text-truncate" title="@item.Title">@item.Title</h6>
                    <span class="text-muted fw-bold" style="font-size: 0.75rem;">
                        by @item.AuthorName
                    </span>
                </div>

                <div class="d-flex align-items-center justify-content-between pt-3 border-top border-light-subtle">
                    <div class="d-flex gap-2">
                        @if (item.SpecialPrice.HasValue)
                        {
                            <span class="text-muted text-decoration-line-through small lh-1"
                                  style="font-size: 0.75rem;">$@string.Format("{0:F2}", item.Price)</span>
                            <span class="fs-5 fw-bold text-danger lh-1">$@string.Format("{0:F2}", item.SpecialPrice)</span>
                        }
                        else
                        {
                            <span class="fs-5 fw-bold text-dark lh-1">$@string.Format("{0:F2}", item.Price)</span>
                        }
                    </div>
                </div>

            </div>
        </div>
    </div>
}

<style>
    .transition-all {
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    }

    .translate-middle-y-hover:hover {
        transform: translateY(-3px);
        box-shadow: 0 5px 10px rgba(0, 0, 0, 0.12);
    }
</style>