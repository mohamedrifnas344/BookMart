@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentStatus = Context.Request.Query["status"].ToString();

    string GetActiveClasses(string controller, string action = "Index", string status = null)
    {
        bool matchesController = string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);
        bool matchesAction = string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
        bool isActive = false;

        if (!string.IsNullOrEmpty(status))
        {
            isActive = matchesController && string.Equals(currentStatus, status, StringComparison.OrdinalIgnoreCase);
        }
        else if (controller == "Order" && action == "Index" && !string.IsNullOrEmpty(currentStatus))
        {
            isActive = false;
        }
        else
        {
            isActive = matchesController && matchesAction;
        }

        return isActive ? "active bg-primary text-white shadow-sm fw-medium" : "link-secondary";
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] BookHaven</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.26.25/dist/sweetalert2.min.css" rel="stylesheet">

    <style>
            :root {
                --sidebar-width: 260px;
            }

            body {
                background-color: #f8f9fa;
            }

            aside {
                width: var(--sidebar-width);
                background-color: #ffffff;
            }

            .nav-link {
                border-radius: 0.375rem;
                transition: background-color 0.15s ease-in-out, color 0.15s ease-in-out;
                font-size: 0.875rem;
            }

                .nav-link:not(.active):hover {
                    background-color: #f1f5f9;
                    color: #0f172a !important;
                }

            .top-navbar {
                background: rgba(255, 255, 255, 0.9);
                backdrop-filter: blur(8px);
            }

            .sidebar-scroll::-webkit-scrollbar {
                width: 4px;
            }

            .sidebar-scroll::-webkit-scrollbar-thumb {
                background: #e2e8f0;
                border-radius: 4px;
            }
    </style>
</head>

<body class="text-dark">

    <div class="container-fluid p-0">
        <div class="row g-0">

            <!-- Desktop Sidebar -->
            <aside class="col-auto d-none d-lg-flex flex-column min-vh-100 p-3 sticky-top border-end border-light sidebar-scroll" 
            style="top: 0; max-height: 100vh; overflow-y: auto;">

                <div class="d-flex align-items-center justify-content-between px-2 py-3 mb-3">
                    <a class="d-flex align-items-center text-dark text-decoration-none gap-2" 
                    asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                        <div class="bg-primary text-white d-flex align-items-center justify-content-center rounded-2 shadow-sm" 
                        style="width: 32px; height: 32px;">
                            <i class="bi bi-lightning-fill fs-6"></i>
                        </div>
                        <span class="fs-4 fw-bold text-danger">
                            BookHaven
                        </span>
                    </a>
                </div>

                <div class="text-uppercase text-muted fw-bold px-2 mb-2" style="font-size: 0.65rem; letter-spacing: 0.8px;">Overview</div>
                <ul class="nav flex-column mb-3 gap-1">
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 d-flex align-items-center text-decoration-none 
                        @GetActiveClasses("Dashboard")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                            <i class="bi bi-grid-1x2 me-3 fs-6"></i> Dashboard
                        </a>
                    </li>
                </ul>

                <div class="text-uppercase text-muted fw-bold px-2 mb-2" style="font-size: 0.65rem; letter-spacing: 0.8px;">Catalog Management</div>
                <ul class="nav flex-column mb-3 gap-1">
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 d-flex align-items-center text-decoration-none 
                        @GetActiveClasses("Category")" asp-area="Admin" asp-controller="Category" asp-action="Index">
                            <i class="bi bi-tags me-3 fs-6"></i> Categories
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 d-flex align-items-center text-decoration-none 
                        @GetActiveClasses("Author")" asp-area="Admin" asp-controller="Author" asp-action="Index">
                            <i class="bi bi-people me-3 fs-6"></i> Authors
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 d-flex align-items-center text-decoration-none 
                        @GetActiveClasses("Book")" asp-area="Admin" asp-controller="Book" asp-action="Index">
                            <i class="bi bi-box-seam me-3 fs-6"></i> Books
                        </a>
                    </li>
                </ul>

                <div class="text-uppercase text-muted fw-bold px-2 mb-2" style="font-size: 0.65rem; letter-spacing: 0.8px;">Sales & Users</div>
                <ul class="nav flex-column mb-4 gap-1">
                    <li class="nav-item">
                        <a asp-area="Admin" asp-controller="Order" asp-action="Index"
                            class="nav-link px-3 py-2 d-flex align-items-center text-decoration-none 
                        @GetActiveClasses("Order")">
                            <i class="bi bi-receipt me-3 fs-6"></i> Orders
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-area="Admin" asp-controller="UserManagement" asp-action="Index"
                            class="nav-link px-3 py-2 d-flex align-items-center text-decoration-none 
                            @GetActiveClasses("UserManagement")">
                            <i class="bi bi-people me-3 fs-6"></i> Users
                        </a>
                    </li>
                </ul>

                <div class="mt-auto pt-3 border-top border-light d-flex align-items-center justify-content-between px-2">
                    <div class="d-flex align-items-center gap-2">
                        <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 30px; height: 30px; font-size: 0.75rem;">
                            AU
                        </div>
                        <div style="line-height: 1.2;">
                            <span class="d-block fw-semibold text-dark small">Admin User</span>
                            <span class="text-muted" style="font-size: 0.7rem;">Administrator</span>
                        </div>
                    </div>
                </div>
            </aside>

            <!-- Main Layout Content -->
            <div class="col d-flex flex-column min-vh-100">

                <!-- Top Navbar -->
                <nav class="navbar navbar-expand-lg top-navbar sticky-top py-2 px-4 border-bottom border-light">
                    <div class="container-fluid px-0">
                        <button class="btn btn-light border d-lg-none me-3" type="button" data-bs-toggle="offcanvas" 
                        data-bs-target="#mobileSidebar" aria-controls="mobileSidebar">
                            <i class="bi bi-list fs-5"></i>
                        </button>

                        <div class="d-flex align-items-center gap-3 ms-auto">
                            <div class="dropdown">
                                <button class="btn btn-light border d-flex align-items-center gap-2 py-1 px-2 rounded-2" 
                                    data-bs-toggle="dropdown" aria-expanded="false">
                                    <div class="bg-primary text-white rounded-circle d-flex align-items-center 
                                    justify-content-center fw-bold" style="width: 28px; height: 28px; font-size: 0.75rem;">
                                        AU
                                    </div>
                                    <span class="d-none d-sm-inline fw-medium small">Account</span>
                                    <i class="bi bi-chevron-down small text-muted"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border mt-2 rounded-2 p-1">
                                    <li>
                                        <form asp-area="Identity" asp-controller="Account" asp-action="Logout" 
                                        method="post">
                                            <button type="submit" class="dropdown-item text-danger py-1.5 small rounded-1 fw-medium">
                                                <i class="bi bi-power me-2"></i> Logout
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </nav>

                <!-- Page Body Content -->
                <main class="flex-grow-1 p-4">

                    <div class="card border border-light shadow-sm p-4 bg-white rounded-3 mb-4">
                        <partial name="_Notification" />
                        @RenderBody()
                    </div>
                </main>

                <!-- Footer -->
                <footer class="text-center py-3 text-muted bg-white border-top border-light small" style="font-size: 0.8rem;">
                    &copy; 2026 <strong>BookHaven</strong> &mdash; Enterprise Management Portal
                </footer>
            </div>

        </div>
    </div>

    <!-- Mobile Offcanvas Sidebar (Synced with Desktop) -->
    <div class="offcanvas offcanvas-start bg-white text-dark shadow-lg border-0" tabindex="-1" id="mobileSidebar" aria-labelledby="mobileSidebarLabel">
        <div class="offcanvas-header border-bottom py-3">
            <h5 class="offcanvas-title fw-bold text-dark d-flex align-items-center gap-2" id="mobileSidebarLabel">
                <div class="bg-primary text-white d-flex align-items-center justify-content-center rounded-2 shadow-sm" style="width: 28px; height: 28px;">
                    <i class="bi bi-lightning-fill fs-6"></i>
                </div>
                BookHaven
            </h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body p-3 sidebar-scroll">
            <div class="text-uppercase text-muted fw-bold px-2 mb-2" style="font-size: 0.65rem; letter-spacing: 0.8px;">Overview</div>
            <ul class="nav flex-column mb-3 gap-1">
                <li class="nav-item">
                    <a class="nav-link px-3 py-2 d-flex align-items-center text-decoration-none @GetActiveClasses("Dashboard")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-grid-1x2 me-3 fs-6"></i> Dashboard
                    </a>
                </li>
            </ul>

            <div class="text-uppercase text-muted fw-bold px-2 mb-2" style="font-size: 0.65rem; letter-spacing: 0.8px;">Catalog Management</div>
            <ul class="nav flex-column mb-3 gap-1">
                <li class="nav-item">
                    <a class="nav-link px-3 py-2 d-flex align-items-center text-decoration-none @GetActiveClasses("Category")" asp-area="Admin" asp-controller="Category" asp-action="Index">
                        <i class="bi bi-tags me-3 fs-6"></i> Categories
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link px-3 py-2 d-flex align-items-center text-decoration-none @GetActiveClasses("Author")" asp-area="Admin" asp-controller="Author" asp-action="Index">
                        <i class="bi bi-award me-3 fs-6"></i> Authors
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link px-3 py-2 d-flex align-items-center text-decoration-none @GetActiveClasses("Book")" asp-area="Admin" asp-controller="Book" asp-action="Index">
                        <i class="bi bi-box-seam me-3 fs-6"></i> Books
                    </a>
                </li>
            </ul>

            <div class="text-uppercase text-muted fw-bold px-2 mb-2" style="font-size: 0.65rem; letter-spacing: 0.8px;">Sales & Users</div>
            <ul class="nav flex-column mb-4 gap-1">
                <li class="nav-item">
                    <a class="nav-link px-3 py-2 d-flex align-items-center text-decoration-none @GetActiveClasses("Order")" asp-area="Admin" asp-controller="Order" asp-action="Index">
                        <i class="bi bi-receipt me-3 fs-6"></i> Orders
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link px-3 py-2 d-flex align-items-center text-decoration-none @GetActiveClasses("User")" asp-area="Admin" asp-controller="UserManagement" asp-action="Index">
                        <i class="bi bi-people me-3 fs-6"></i> User Accounts
                    </a>
                </li>
            </ul>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.26.25/dist/sweetalert2.all.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.5.1/dist/chart.umd.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>